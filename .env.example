# Lodgekeys — Supabase Environment Configuration (Frontend)
# Copy this file to .env and replace the placeholder values with your Supabase project credentials.
# NOTE: Only public/anon keys belong in the frontend. NEVER expose the service_role key!

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Publishable API Key (safe for browser usage with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
